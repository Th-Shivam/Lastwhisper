# Paths may be absolute or relative to backend/
DATABASE_URL=sqlite:///./data/lastwhisper.sqlite3
STORAGE_DIR=./data/audio
MAX_UPLOAD_SIZE_MB=100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# faster-whisper downloads model weights on first use unless this points to a pre-populated local cache.
WHISPER_MODEL=base
WHISPER_REVISION=ebe41f70d5b6dfa9166e2c581c45c9c0cfc57b66
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_DOWNLOAD_ROOT=./data/models/whisper
WHISPER_LOCAL_FILES_ONLY=false
MAX_PROCESSING_DURATION_SECONDS=14400
MAX_TRANSCRIPTION_JOBS=3
# Optional local-only enrichment. Leave blank to keep summaries unavailable.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://127.0.0.1:11434
# Remote endpoints receive transcript text and are rejected unless explicitly enabled.
ALLOW_REMOTE_OLLAMA=false
OLLAMA_MAX_RESPONSE_BYTES=1000000
# Local semantic search. The model downloads on first use unless already cached.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
# Immutable default-model revision; pin a compatible revision for another model.
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# Keep this directory after the one-time online model download.
# EMBEDDING_CACHE_DIR=./data/models/embeddings
# Set true only after the configured model exists in the local cache.
EMBEDDING_LOCAL_FILES_ONLY=false
# Prefer standard HTTPS downloads over the optional Xet transport.
HF_HUB_DISABLE_XET=true
# Cosine similarity is a ranking signal from -1 to 1, not a probability.
SEARCH_MIN_SIMILARITY=0.30
SEARCH_CHUNK_CHARACTERS=700
SEARCH_CHUNK_OVERLAP_SEGMENTS=1
